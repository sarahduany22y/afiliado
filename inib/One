            color: #ffffff;
            padding: 16px 15px;
            font-size: 1.3rem;
            font-weight: 700;
            border-bottom: 2px solid rgba(255, 255, 255, 0.2);
        }

        .blue-content-box {
            background-color: var(--blue-primary);
            color: #ffffff;
            padding: 20px 15px 30px;
